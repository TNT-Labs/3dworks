# Copia in `.env` accanto al docker-compose.yml.
# Il token del tunnel si ottiene creando il tunnel nel pannello Cloudflare:
#   Zero Trust → Networks → Tunnels → Create a tunnel → Docker
# Cloudflare mostra un comando che contiene `--token eyJhIjoi…`: quella è la
# stringa da incollare qui. Vale come una password: non finisce su GitHub.
#
# Solo il valore: niente `--token` davanti, niente virgolette, tutto su una
# riga sola. All'avvio viene controllato prima che il tunnel parta, così un
# copia-incolla sbagliato lo dice subito invece di limitarsi a «Provided
# Tunnel token is not valid».
TUNNEL_TOKEN=

# Se configuri l'invio email, la password SMTP sta qui e non nel compose.
SMTP_PASS=

# --- privacy (GDPR) ---
# Titolare del trattamento e recapiti: finiscono nell'informativa servita
# dal sito (/privacy.html). Finché restano vuoti la pagina lo dichiara.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTROLLER_VAT=
# Dove gira il server, per la voce "infrastruttura" dei destinatari.
PRIVACY_HOSTING=Raspberry Pi presso la sede del titolare
