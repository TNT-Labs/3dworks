{
  "name": "vortice-studio",
  "version": "1.0.0",
  "private": true,
  "description": "VORTICE · studio generativo web per dispenser e portaspazzolino stampabili in 3D",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "postinstall": "node scripts/vendor-three.js",
    "test": "node --test test/design-spec.test.js test/design-model.test.js test/api.test.js test/proxy.test.js test/watertight.test.js",
    "test:e2e": "node --test --test-timeout=600000 test/browser.test.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "three": "0.160.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
