# ============================================================
# VORTICE · configurazione del server
# Copia questo file in .env e adatta i valori, oppure imposta
# le stesse variabili nell'ambiente del tuo hosting.
# Tutto ha un default sensato: per provare in locale basta
# `npm install && npm start`, senza alcun file .env.
# ============================================================

# --- rete ---
PORT=3000
HOST=0.0.0.0

# Indirizzo pubblico del sito. Serve nei link dentro le email di
# conferma e reimpostazione password. Lasciato vuoto viene dedotto
# dalla richiesta, cosa che non funziona dietro alcuni proxy.
VORTICE_BASE_URL=

# Proxy davanti all'applicazione (nginx, Caddy, Traefik, un tunnel
# Cloudflare, un PaaS). Senza, il limite sui tentativi vede l'indirizzo del
# proxy per tutti e i cookie non sanno di viaggiare in HTTPS.
#   0 / vuoto  nessun proxy
#   1, 2, …    numero di hop fidati (dietro un tunnel Cloudflare: 1)
#   true       fidati di tutta la catena (solo in rete chiusa)
#   elenco     indirizzi o CIDR separati da virgola
TRUST_PROXY=0

# A 1 il vero indirizzo del visitatore viene letto da CF-Connecting-IP.
# Serve dietro Cloudflare: senza, tutte le richieste sembrano venire dal
# tunnel e il limite sui tentativi di accesso diventa collettivo — il primo
# che sbaglia la password blocca tutti gli altri.
# Da attivare SOLO se la porta dell'applicazione non è raggiungibile
# scavalcando Cloudflare (vedi DEPLOY.md).
CLOUDFLARE=0

# --- database ---
# Percorso del file SQLite. Relativo alla cartella del progetto se non
# assoluto. In produzione puntalo a un volume persistente.
VORTICE_DB=data/vortice.db

# --- sessioni e password ---
# Il cookie di sessione viaggia solo su HTTPS. Attivalo in produzione.
COOKIE_SECURE=0
SESSION_DAYS=30
MIN_PASSWORD_LENGTH=10

# --- registrazione ---
# A 0 nessuno può più creare account: utile per un'istanza privata
# dopo aver registrato le persone che servono.
ALLOW_REGISTRATION=1

# A 1 l'account resta inattivo finché non si clicca il link ricevuto
# via email. Richiede SMTP_HOST configurato: senza, il server si
# rifiuta di partire invece di chiudere fuori tutti.
REQUIRE_EMAIL_VERIFICATION=0

# --- quote ---
MAX_DESIGNS_PER_USER=200
MAX_PREVIEW_BYTES=614400

# --- privacy (GDPR) ---
# Recapiti del titolare del trattamento, mostrati nell'informativa
# (/privacy.html) e serviti da /api/legal. Senza questi due valori
# l'informativa dichiara apertamente di essere incompleta: vanno
# compilati prima di aprire il sito al pubblico.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTROLLER_VAT=

# Responsabile della protezione dei dati, se nominato (art. 37).
PRIVACY_DPO_EMAIL=

# Dove gira il server: compare tra i destinatari dell'informativa
# (es. "Raspberry Pi presso la sede di Milano" o il nome dell'hosting).
PRIVACY_HOSTING=

# Versione dell'informativa. Viene registrata insieme alla presa visione
# di ogni account: cambiandola, a chi ha accettato la versione precedente
# viene chiesto di leggerla di nuovo dalla pagina account.
PRIVACY_POLICY_VERSION=2026-09-19

# Autorità di controllo a cui rivolgere reclamo (art. 77). I default
# valgono per l'Italia.
PRIVACY_AUTHORITY=Garante per la protezione dei dati personali
PRIVACY_AUTHORITY_URL=https://www.garanteprivacy.it

# --- conservazione dei dati ---
# Cancellazione automatica degli account mai confermati. Ha effetto solo
# con REQUIRE_EMAIL_VERIFICATION=1, perché altrimenti gli account nascono
# già attivi. 0 disattiva.
UNVERIFIED_ACCOUNT_DAYS=30

# Cancellazione automatica degli account senza accessi da N giorni,
# creazioni comprese. 0 (default) non cancella nulla: attivalo solo se hai
# deciso una politica di conservazione e l'hai scritta nell'informativa.
INACTIVE_ACCOUNT_DAYS=0

# Con SMTP non configurato i link di conferma e reimpostazione finiscono
# nel log del server: comodissimo in sviluppo, da evitare in produzione
# (sono credenziali, e il log conterrebbe indirizzi email in chiaro).
# Default: attivo solo fuori da NODE_ENV=production.
LOG_MAIL_LINKS=

# --- invio email (facoltativo) ---
# Senza SMTP_HOST non viene inviata alcuna email: i link di conferma e
# di reimpostazione compaiono nel log del server, così l'applicazione
# resta utilizzabile anche in una rete interna.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VORTICE <no-reply@esempio.it>
